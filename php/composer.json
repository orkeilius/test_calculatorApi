{
    "name": "calculator/api-php",
    "description": "API Calculatrice en PHP avec Tests et CI",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Calculator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "start": "php -S 0.0.0.0:3000 -t public/ public/index.php",
        "test": "phpunit",
        "test:unit": "phpunit tests/CalculatorTest.php",
        "test:integration": "phpunit tests/ApiTest.php",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:ci": "phpunit --coverage-clover coverage/clover.xml --coverage-html coverage"
    },
    "config": {
        "optimize-autoloader": true
    }
}
